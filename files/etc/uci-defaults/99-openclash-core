#!/bin/sh
# Copy OpenClash cores from /usr/share/openclash/core to /etc/openclash/core on first boot
# This script is placed at files/etc/uci-defaults/99-openclash-core in the build files/ tree.

CORE_SRC_DIR="/usr/share/openclash/core"
CORE_DST_DIR="/etc/openclash/core"

mkdir -p "$CORE_DST_DIR"

for f in "$CORE_SRC_DIR"/*; do
  [ -e "$f" ] || continue
  base="$(basename "$f")"
  dst="$CORE_DST_DIR/$base"
  # Copy if destination doesn't exist or isn't executable
  if [ ! -x "$dst" ]; then
    cp -f "$f" "$dst"
    chmod +x "$dst"
  fi
done

# Remove itself so uci-defaults doesn't run it again
rm -f /etc/uci-defaults/99-openclash-core
exit 0
